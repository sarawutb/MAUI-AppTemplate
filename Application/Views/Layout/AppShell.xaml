                FontFamily="MaterialIcons"
                FontSize="24"
                HorizontalOptions="End"
                Text="{x:Static ex:IconFont.Add}" />
        </StackLayout>
    </Shell.TitleView>-->

    <!--  Flyout Menu Items  -->
    <FlyoutItem
        x:Name="menuHome"
        Title="Home"
        FlyoutDisplayOptions="AsSingleItem"
        Icon="{StaticResource MaterialIconHome_filled}">
        <ShellContent ContentTemplate="{DataTemplate local:MainView}" Route="MainView" />
        <!--<ShellContent ContentTemplate="{DataTemplate local:LoginView}" Route="LoginView" />-->
    </FlyoutItem>

    <!--<FlyoutItem
        Title="Home"
        FlyoutDisplayOptions="AsSingleItem"
        FlyoutIcon="{StaticResource MaterialIconHome}">

        <Tab Title="Tab 1" Icon="{StaticResource MaterialIconHome}">
            <ShellContent
                Title="One"
                ContentTemplate="{DataTemplate local:Page1}"
                Route="OnePage" />
        </Tab>
        <Tab Title="Tab 2" Icon="{StaticResource MaterialIconHome}">
            <ShellContent
                Title="Two"
                ContentTemplate="{DataTemplate local:Page2}"
                Route="TwoPage" />
        </Tab>
        <Tab Title="Tab 3" Icon="{StaticResource MaterialIconHome}">
            <ShellContent
                Title="Three"
                ContentTemplate="{DataTemplate local:Page3}"
                Route="ThreePage" />
        </Tab>
    </FlyoutItem>-->

    <!--<FlyoutItem Title="Screen2" Icon="{StaticResource MaterialIconFullscreen}">
        <ShellContent Route="Screen2" />
    </FlyoutItem>

    <FlyoutItem Title="ToDo" Icon="{StaticResource MaterialIconRun_circle}">
        <ShellContent Route="ToDo" />
    </FlyoutItem>-->
    <FlyoutItem
        Title="Setting"
        Icon="{StaticResource MaterialIconSettings}"
        Route="SettingView">
        <ShellContent Route="SettingView" />
    </FlyoutItem>
    <Shell.FlyoutFooterTemplate>
        <DataTemplate>
            <StackLayout>
                <BoxView
                    Grid.Row="1"
                    Grid.ColumnSpan="2"
                    Margin="0"
                    HeightRequest="0.1"
                    StyleClass="Divider" />
                <Grid VerticalOptions="Start">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <!--<StackLayout
                        Grid.Row="0"
                        Grid.ColumnSpan="2"
                        Padding="10,8"
                        Orientation="Horizontal">
                        <Label
                            FontFamily="MaterialIcons"
                            FontSize="24"
                            HorizontalOptions="Start"
                            Text="{StaticResource MaterialIconSettings}"
                            TextColor="{StaticResource MaterialWarningOrange}"
                            VerticalOptions="End" />
                        <Label
                            Padding="10,0,0,0"
                            FontAttributes="Bold"
                            FontSize="13"
                            HorizontalOptions="StartAndExpand"
                            Text="Setting"
                            TextColor="{StaticResource Gray600}"
                            VerticalOptions="Center" />
                    </StackLayout>-->

                    <StackLayout
                        Grid.Row="2"
                        Grid.ColumnSpan="2"
                        Padding="10,8"
                        BackgroundColor="{StaticResource MaterialDanger}"
                        Orientation="Horizontal">
                        <Label
                            FontFamily="MaterialIcons"
                            FontSize="24"
                            HorizontalOptions="Start"
                            Text="{StaticResource MaterialIconLogout}"
                            TextColor="{StaticResource White}"
                            VerticalOptions="End" />
                        <Label
                            Padding="10,0,0,0"
                            FontAttributes="Bold"
                            FontSize="13"
                            HorizontalOptions="StartAndExpand"
                            Text="Log Out"
                            TextColor="{StaticResource White}"
                            VerticalOptions="Center" />
                    </StackLayout>
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AppShellViewModel}}, Path=LogoutCommand}" NumberOfTapsRequired="1" />
                    </Grid.GestureRecognizers>
                </Grid>
                <!--<Grid
                    Padding="10"
                    BackgroundColor="{StaticResource MaterialWarningOrange}"
                    HeightRequest="150">
                    <Label
                        FontSize="20"
                        HorizontalOptions="Start"
                        Text="App2 Navigation"
                        TextColor="White"
                        VerticalOptions="Center" />
                </Grid>-->
            </StackLayout>
        </DataTemplate>
    </Shell.FlyoutFooterTemplate>
</Shell>

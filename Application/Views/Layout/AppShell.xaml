    xmlns:vm="clr-namespace:MAUIPos.Application.ViewModels"
    Title="MAUIPos"
    Shell.BackgroundColor="White"
    Shell.FlyoutBehavior="Flyout"
    Shell.ForegroundColor="#2B3048"
    Shell.PresentationMode="Animated"
    Shell.TabBarIsVisible="False"
    Shell.TabBarTitleColor="{StaticResource MaterialWarningOrange}"
    Shell.TitleColor="{StaticResource MaterialWarningOrange}">
    <Shell.BindingContext>
        <vm:AppShellViewModel />
    </Shell.BindingContext>


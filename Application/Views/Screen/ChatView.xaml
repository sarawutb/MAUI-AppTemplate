<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MAUIPos.Application.Views.Screen.ChatView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:fa="clr-namespace:UraniumUI.Icons.FontAwesome;assembly=UraniumUI.Icons.FontAwesome"
    xmlns:vm="clr-namespace:MAUIPos.Application.ViewModels"
    Title="ChatView">
    <Shell.TitleView>
        <StackLayout Orientation="Horizontal">
            <StackLayout HorizontalOptions="FillAndExpand" Orientation="Horizontal">
                <Label
                    BackgroundColor="Transparent"
                    FontAttributes="Bold"
                    FontSize="22"
                    HorizontalOptions="StartAndExpand"
                    Text="ChatView"
                    TextColor="{StaticResource MaterialWarningOrange}"
                    VerticalOptions="Center" />
                <StackLayout
                    Padding="15,0"
                    HorizontalOptions="End"
                    VerticalOptions="FillAndExpand">
                    <Image VerticalOptions="CenterAndExpand" WidthRequest="25">
                        <Image.Source>
                            <FontImageSource
                                FontFamily="FASolid"
                                Glyph="{x:Static fa:Solid.Rotate}"
                                Color="{StaticResource MaterialWarningOrange}" />
                        </Image.Source>
                    </Image>
                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding LoadRoomCommand}" NumberOfTapsRequired="1" />
                    </StackLayout.GestureRecognizers>
                </StackLayout>
            </StackLayout>
        </StackLayout>
    </Shell.TitleView>
    <ContentPage.BindingContext>
        <vm:ChatViewModel />
    </ContentPage.BindingContext>
    <StackLayout HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
        <!--<Label
            Margin="0,10,0,0"
            FontAttributes="Bold"
            FontSize="15"
            HorizontalOptions="Center"
            Text="List of Chat Room Names" />
        <Label Text="{Binding LstRoom.Count}" />-->
        <ListView ItemsSource="{Binding LstRoom}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <ViewCell>
                        <VerticalStackLayout>
                            <HorizontalStackLayout Padding="5">
                                <Image
                                    Margin="5,0"
                                    VerticalOptions="CenterAndExpand"
                                    WidthRequest="20">
                                    <Image.Source>
                                        <FontImageSource
                                            FontFamily="FASolid"
                                            Glyph="{x:Static fa:Solid.DoorClosed}"
                                            Color="{StaticResource MaterialWarningOrange}" />
                                    </Image.Source>
                                </Image>
                                <Label
                                    Padding="10"
                                    FontSize="15"
                                    HorizontalOptions="FillAndExpand"
                                    Text="{Binding .}" />
                            </HorizontalStackLayout>
                            <Border />
                            <VerticalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ChatViewModel}}, Path=GoToRoomCommand}"
                                    CommandParameter="{Binding .}"
                                    NumberOfTapsRequired="1" />
                            </VerticalStackLayout.GestureRecognizers>
                        </VerticalStackLayout>
                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </StackLayout>
</ContentPage>
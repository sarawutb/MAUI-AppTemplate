<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="MAUIPos.Application.Widget.PopupAppBar"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="Transparent">
    <VerticalStackLayout BackgroundColor="Transparent">
        <Frame
            Margin="3"
            Padding="3"
            BackgroundColor="White"
            CornerRadius="5"
            HeightRequest="500"
            VerticalOptions="Center"
            WidthRequest="250">
            <StackLayout VerticalOptions="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                </Grid>
                <StackLayout HeightRequest="25">
                    <Label
                        FontFamily="MaterialIcons"
                        FontSize="24"
                        Text="&#xE8B8;" />
                    <Label Text="All" />
                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer NumberOfTapsRequired="1" Tapped="TapGestureRecognizer_Tapped1" />
                    </StackLayout.GestureRecognizers>
                </StackLayout>
                <StackLayout HeightRequest="25">
                    <Label
                        FontFamily="MaterialIcons"
                        FontSize="24"
                        Text="&#xE8B8;" />
                    <Label Text="Show Completed" />
                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer NumberOfTapsRequired="1" Tapped="TapGestureRecognizer_Tapped2" />
                    </StackLayout.GestureRecognizers>
                </StackLayout>
                <StackLayout HeightRequest="25">
                    <Label
                        FontFamily="MaterialIcons"
                        FontSize="24"
                        Text="&#xE8B8;" />
                    <Label Text="All Active" />
                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer NumberOfTapsRequired="1" Tapped="TapGestureRecognizer_Tapped3" />
                    </StackLayout.GestureRecognizers>
                </StackLayout>
            </StackLayout>
        </Frame>
    </VerticalStackLayout>
</ContentView>
